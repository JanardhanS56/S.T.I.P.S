{
  "name": "stips",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "S.T.I.P.S - Student-Teacher Interaction and Polling System (prototype)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:all": "node scripts/dev.js",
    "dev:client": "vite",
    "dev:web": "vite",
    "dev:server": "node server/dev.js",
    "dev:api": "node server/dev.js",
    "build": "vite build",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "node --env-file=.env scripts/load-smoke.js",
    "test:smoke": "node --env-file=.env scripts/smoke-test.js",
    "test:backup": "node --env-file=.env scripts/backup-drill.js",
    "security:scan": "node scripts/scan-secrets.js",
    "licenses": "node scripts/generate-third-party.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "seed:test": "node --env-file=.env.test scripts/seed-test.js",
    "seed:large": "node --env-file=.env scripts/seed-large.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/node": "^11.13.0",
    "@sentry/react": "^11.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "gsap": "^3.15.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.76.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autocannon": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "supertest": "^7.3.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
