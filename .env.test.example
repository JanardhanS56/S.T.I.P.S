# Test environment configuration for S.T.I.P.S
# MUST point to a dedicated staging/test Supabase project, NEVER production!
NODE_ENV=test
PORT=3002

# Supabase Test Project (Project Settings > API)
SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
APPROVED_TEST_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Test JWT secret (for test suite only)
JWT_SECRET=test-secret-at-least-32-chars-long-for-testing-purpose

# Optional LLM settings for tests (leave empty to use mock/word filter)
LLM_API_KEY=
