# Supabase (Project Settings > API). The service role key is SECRET: server only, never in the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional AI content screening (any OpenAI-compatible API: Groq, OpenRouter, NVIDIA).
# Leave LLM_API_KEY empty to use only the built-in word filter.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
